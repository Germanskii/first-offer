{
  "name": "first-offer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/check-feed.mjs",
    "build:resume-pdf": "esbuild scripts/pdf-entry.js --bundle --format=esm --platform=browser --minify --outfile=dist/client/vendor/cv-pdf.js",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.1"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "pdf-lib": "^1.17.1"
  },
  "description": "First Offer - internship-first job tracker with truthful CV adaptation",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
